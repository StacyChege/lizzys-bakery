# Django secret key — generate a new one for production, never reuse the dev value.
SECRET_KEY=

# Never True in production.
DEBUG=False

# Postgres connection string, e.g. postgres://user:password@host:5432/dbname
DATABASE_URL=

# Comma-separated. Must include the backend's real domain in production.
ALLOWED_HOSTS=127.0.0.1,localhost

# Comma-separated, full origin including scheme. Must include the frontend's
# real domain in production, or the browser will block API requests.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Comma-separated, full origin including scheme. Must include the backend's
# real domain in production (needed for the Django admin's CSRF check).
CSRF_TRUSTED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
